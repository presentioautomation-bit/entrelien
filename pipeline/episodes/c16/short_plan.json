{"SEGS": [{"k": "01", "s": 0, "len": 4.699, "pre": 0.25, "vs": 0.6, "r": 0.9508567589862138}, {"k": "03", "s": 4.699, "len": 9.997, "pre": 0.35, "vs": 11.79, "r": 1.0175891528673036}, {"k": "04", "s": 14.696, "len": 10.311, "pre": 0.35, "vs": 21.95, "r": 0.9873634216995705}, {"k": "05", "s": 25.007, "len": 6.941, "pre": 0.35, "vs": 32.41, "r": 0.9998352452423034}, {"k": "06", "s": 31.948, "len": 4.731, "pre": 0.35, "vs": 39.35, "r": 1.0437838403533992}], "SUBS": [[0.25, 2.66, "Je lui avais dit : « Appelez-moi quand vous voulez. »…"], [3.23, 4.3, "Il m'a pris au mot."], [5.05, 8.15, "Un samedi, un homme m'appelle pour une petite difficulté."], [8.15, 9.62, "Je l'aide, tout fonctionne."], [9.62, 14.3, "Avant de raccrocher, il me demande : « Si je n'y arrive pas, je peux vous rappeler ? »"], [15.05, 16.58, "Puis il hésite : « Mais bon…"], [16.58, 19.09, "je ne peux pas vous appeler n'importe quand. »"], [19.09, 20.52, "Je lui réponds : « Si, si."], [20.52, 22.16, "Appelez-moi quand vous voulez."], [22.16, 24.34, "Si je peux vous aider, je décrocherai. »"], [25.36, 26.27, "J'étais sincère."], [26.59, 29.5, "Dans mon métier, il n'y a pas vraiment de jour ni d'heure."], [29.87, 31.55, "Et puis, c'était samedi."], [32.3, 34.53, "Dimanche matin, je regarde mon téléphone."], [34.98, 35.93, "Un appel manqué."]], "CARD": 36.679183, "END": 41.78}